{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SanlyControl",
  "version": "1.0.0",
  "identifier": "tm.sanlycontrol.desktop",
  "build": {
    "beforeBuildCommand": "pnpm desktop:prepare",
    "beforeDevCommand": "pnpm desktop:prepare",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "category": "Education",
    "shortDescription": "Ýerli torda işleýän sanly synp dolandyryş ulgamy",
    "longDescription": "SanlyControl sapak, ekran paýlaşma, synag we netijeleri bir ýerde dolandyrýar.",
    "resources": {
      "runtime/node.exe": "node.exe",
      "runtime/app": "app"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
